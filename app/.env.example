# Application
APP_NAME="Broadcast Information"
APP_HOST=localhost
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DEBUG=false

# Database (relative paths are resolved against the app/ directory)
DATABASE_URL=sqlite:///database/broadcast_db.sqlite

# Authentication - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
SESSION_SECRET_KEY=replace-with-another-random-64-char-hex-string
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_NAME=broadcast_session
COOKIE_HTTPS_ONLY=false

# Uploads
STORAGE_DIR=storage/documents
MAX_UPLOAD_MB=20

# Mail
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
SHARP_SMTP_HOST=relay.sharp.co.jp
SHARP_SMTP_PORT=25
SHARP_SMTP_STARTTLS=true
OFFICE_SMTP_HOST=smtp.office365.com
OFFICE_SMTP_PORT=587
OFFICE_SMTP_STARTTLS=true

# UI
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
